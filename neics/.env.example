# NEICS environment configuration (Staging / UAT). Copy to .env and adjust.
# All variables are prefixed NEICS_.

# Database. Default is file-based SQLite (zero-infra local dev).
# docker-compose overrides this with the PostgreSQL DSN.
NEICS_DATABASE_URL=sqlite:///./neics.db
# Example PostgreSQL DSN:
# NEICS_DATABASE_URL=postgresql+psycopg2://neics:neics_staging_pw@localhost:5432/neics

# JWT signing secret — CHANGE THIS for any shared environment.
NEICS_JWT_SECRET=change-me-staging-secret
NEICS_JWT_EXPIRE_MINUTES=480

# Seed reference data + test dataset on startup if the database is empty.
NEICS_AUTO_SEED=true

# CORS origins ("*" for local UAT; restrict in shared environments).
NEICS_CORS_ORIGINS=*

# Methodology version reported by the engine and stamped on classifications.
NEICS_METHODOLOGY_VERSION=1.0.0
