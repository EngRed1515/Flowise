# Copy to .env and fill in. NEVER commit your real .env.
# ---------------------------------------------------------------------------
# Database (SQLite by default; set a Postgres URL to switch).
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/gcc_door_intel

# --- Alerts: Email (SMTP) --------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USER=you@example.com
# SMTP_PASSWORD=app-specific-password
# ALERT_EMAIL_FROM=alerts@sbk-internal.com
# ALERT_EMAIL_TO=sales@sbk-internal.com,owner@sbk-internal.com

# --- Alerts: Generic webhook (Slack / Telegram / WhatsApp bridge) ----------
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# --- Source credentials (LATER PHASES — official API access only) ----------
# Never used to scrape. Only for sources that grant official API/integration.
# MEED_API_KEY=
# MEED_API_BASE_URL=
